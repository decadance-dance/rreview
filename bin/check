#!/bin/sh
# The merge gate (CI job `ci-ok`): format, lints, tests, then the Orca plugin's check and tests
# (`orca` must be on PATH). Every step runs; any failure fails.
cd "$(dirname "$0")/.." || exit 1
status=0
cargo fmt --check || status=1
cargo clippy --all-targets -- -D warnings || status=1
cargo test || status=1
orca plugin check orca-plugin || status=1
orca plugin test orca-plugin || status=1
exit $status
