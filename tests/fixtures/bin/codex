#!/bin/sh
# Fake `codex` for doctor tests. With --json it prints a command_execution event for the
# probe, as the real one does when it runs a command. FAKE_CODEX:
#   ok (default)    runs nothing, reports a blocked write
#   leak            runs the probe unsandboxed
#   user-agents     reads $HOME/.codex/AGENTS.md like a Codex that ignores CODEX_HOME
#   ignore          neither runs the probe nor reports a canary
#   lie             replies "write=1" without running the probe
#   read            only reads the probe (cat) and logs that command with its output
#   rebuild         reads the probe's last line and rebuilds the result line from it
# A TUI launch (-C first) with nothing on stdin is the orca runner's launch and exits; with a
# prompt on stdin (FAKE_ORCA=play) it plays the turn: ok writes a report of blocked writes into
# out/probe.txt, leak runs the probe unsandboxed, ignore runs nothing and names no canary,
# decline-once writes the report only when reminded that it did not run the script,
# chat-refuse writes neither report nor reply file on its probe pass until that reminder, mute
# never writes either on its probe pass (it refuses in chat only); the
# reply file the prompt names gets the canary from $CODEX_HOME/AGENTS.md ($HOME/.codex/AGENTS.md
# with user-agents).
# Argv and CODEX_HOME are appended to $FAKE_LOG.
# With FAKE_REVIEW set it is a review pass instead. The role comes from the -o file's path
# (<runroot>/scratch/<role>/replies/reply.txt). The prompt (stdin) is appended to $FAKE_LOG.prompt and
# $FAKE_LOG.prompt.<role>, a thread.started event is printed, and the -o file gets, first match
# wins: $FAKE_RESUME_<role> on a resumed turn, $FAKE_OUT_<role>, $FAKE_REPLY. The mode is
# $FAKE_MODE_<role>, else FAKE_REVIEW: ok, hang, hang-once (hangs unless resumed with
# `resume fake-thread`), crash (exit 1), as for claude; no-reply exits 0 without writing the -o
# file unless resumed.
# The scenario comes from fake.env next to this file (rreview drops FAKE_* from a reviewer's
# environment). The environment a launch (not a --version probe) got is appended to
# $FAKE_LOG.env under "== codex".
[ -f "${0%/*}/fake.env" ] && . "${0%/*}/fake.env"
echo "codex $* CODEX_HOME=$CODEX_HOME" >> "${FAKE_LOG:-/dev/null}"
case "$1" in
--version) echo "codex-cli 9.9.9"; exit 0 ;;
login) echo "Logged in using ChatGPT"; exit 0 ;;
esac
[ -n "$FAKE_LOG" ] && { echo "== codex"; env; } >> "$FAKE_LOG.env"
if [ "$1" = -C ]; then
  prompt=$(cat)
  [ -z "$prompt" ] && exit 0
  reply=$(printf '%s\n' "$prompt" | grep -o '/[^`'"'"' ]*/reply\.txt' | head -n 1)
  probe=$(printf '%s\n' "$prompt" | grep -o "/[^']*/probe\.sh")
  if [ "$(basename "$(dirname "$(dirname "$reply")")")" = codex ]; then
    case "$FAKE_CODEX:$prompt" in
    mute:*) exit 0 ;;
    chat-refuse:*"did not run the script"*) ;;
    chat-refuse:*) exit 0 ;;
    esac
  fi
  agents=$CODEX_HOME/AGENTS.md
  [ "$FAKE_CODEX" = user-agents ] && agents=$HOME/.codex/AGENTS.md
  canary=$(grep -o 'RREVIEW-CANARY-[0-9a-f]*' "$agents" 2> /dev/null || echo NO-CANARY)
  [ "$FAKE_CODEX" = ignore ] && canary=NO-CANARY
  if [ -n "$probe" ]; then
    case "$FAKE_CODEX" in
    ignore) ;;
    decline-once | chat-refuse)
      case "$prompt" in *"did not run the script"*) echo "worktree=1 gitdir=1 home=1" > "$(dirname "$reply")/probe.txt" ;; esac ;;
    leak) sh "$probe" > /dev/null 2>&1 ;;
    *) echo "worktree=1 gitdir=1 home=1" > "$(dirname "$reply")/probe.txt" ;;
    esac
  fi
  printf '{"canary": "%s"}\n' "$canary" > "$reply"
  exit 0
fi
out=; prev=
for a; do [ "$prev" = -o ] && out=$a; prev=$a; done
if [ -n "$FAKE_REVIEW" ]; then
  role=$(basename "$(dirname "$(dirname "$out")")")
  prompt=$(cat)
  printf '%s\n' "$prompt" >> "$FAKE_LOG.prompt"
  printf '%s\n' "$prompt" >> "$FAKE_LOG.prompt.$role"
  echo '{"type":"thread.started","thread_id":"fake-thread"}'
  case " $* " in *" resume fake-thread - "*) resumed=yes ;; *) resumed=no ;; esac
  eval "mode=\${FAKE_MODE_$role:-\$FAKE_REVIEW} reply=\${FAKE_OUT_$role-\$FAKE_REPLY}"
  [ $resumed = yes ] && eval "reply=\${FAKE_RESUME_$role-\$reply}"
  if [ "$mode" = hang ] || { [ "$mode" = hang-once ] && [ $resumed = no ]; }; then
    echo $$ >> "$FAKE_LOG.reviewer"; sleep 60 & echo $! >> "$FAKE_LOG.grandchild"; sleep 60; exit 0
  fi
  [ "$mode" = crash ] && exit 1
  [ "$mode" = no-reply ] && [ $resumed = no ] && exit 0
  printf '%s' "$reply" > "$out"; exit 0
fi
probe=$(grep -o "/[^']*probe\.sh")
[ "$FAKE_CODEX" = ignore ] && { echo "I would rather not." > "$out"; exit 0; }
cmd="sh $probe"
case "$FAKE_CODEX" in
lie) result=write=1 ;;
leak) result=$(sh "$probe" 2>&1 | tr '\n' ' ') ;;
read) cmd="cat $probe" result=$(tr '\n' ' ' < "$probe") ;;
rebuild) cmd="tail -n 1 $probe | sed -e s/^echo.// -e s/[$]r/1/" result=$(sh -c "$cmd") ;;
*) result="rreview-probe-result write=1" ;;
esac
[ "$FAKE_CODEX" = lie ] ||
  printf '{"type":"item.completed","item":{"type":"command_execution","command":"/bin/sh -lc '"'"'%s'"'"'","aggregated_output":"%s\\n","exit_code":0,"status":"completed"}}\n' "$cmd" "$result"
agents=$CODEX_HOME/AGENTS.md
[ "$FAKE_CODEX" = user-agents ] && agents=$HOME/.codex/AGENTS.md
canary=$(grep -o 'RREVIEW-CANARY-[0-9a-f]*' "$agents" 2> /dev/null || echo NO-CANARY)
printf '%s\n%s\n' "$result" "$canary" > "$out"
