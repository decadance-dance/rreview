#!/bin/sh
# Fake `claude` for doctor tests. Like the real one it fires the project's hooks
# (.claude/settings.json in its cwd) unless given --safe-mode, and without --safe-mode (the
# doctor's hook control, which has no login) it then fails. FAKE_CLAUDE:
#   ok (default)    behaves like a working sandbox
#   no-safe-mode    --help does not offer --safe-mode
#   leak            runs the probe unsandboxed, as if the sandbox let everything through
#   ignore          does not run the probe
#   lie             skips the probe and reports "write=0 commit=0 branch=0 diff=99"
#   crash           writes the normal results, then exits 42
#   hook            fires the project hooks even under --safe-mode
#   dead-hook       never fires hooks, as if the planted hook were broken
# Argv is appended to $FAKE_LOG.
# With FAKE_REVIEW set it is a review pass instead: the prompt (stdin) is appended to
# $FAKE_LOG.prompt and $FAKE_STDOUT is printed. FAKE_REVIEW:
#   ok              replies at once
#   hang            starts a grandchild (pids appended to $FAKE_LOG.grandchild), then never replies
#   hang-once       hangs like `hang` unless resumed (--resume), then replies
#   forge           first writes $FAKE_FORGED into out/reliability.json, which the sandbox allows
#   symlink         first plants out/reliability.json as a symlink to $FAKE_LOG.victim
echo "claude $*" >> "${FAKE_LOG:-/dev/null}"
case "$1" in
--version) echo "9.9.9 (Claude Code)"; exit 0 ;;
--help)
  echo "Usage: claude [options] [prompt]"
  [ "$FAKE_CLAUDE" = no-safe-mode ] || echo "  --safe-mode  Disable user and project customizations"
  exit 0 ;;
auth) echo '{"loggedIn": true, "authMethod": "fake"}'; exit 0 ;;
esac
if [ -n "$FAKE_REVIEW" ]; then
  cat >> "$FAKE_LOG.prompt"
  case " $* " in *" --resume "*) resumed=yes ;; *) resumed=no ;; esac
  if [ "$FAKE_REVIEW" = hang ] || { [ "$FAKE_REVIEW" = hang-once ] && [ $resumed = no ]; }; then
    sleep 60 & echo $! >> "$FAKE_LOG.grandchild"; sleep 60; exit 0
  fi
  settings=; prev=
  for a; do [ "$prev" = --settings ] && settings=$a; prev=$a; done
  out=$(dirname "$settings")/out/reliability.json
  [ "$FAKE_REVIEW" = forge ] && printf '%s' "$FAKE_FORGED" > "$out"
  [ "$FAKE_REVIEW" = symlink ] && ln -s "$FAKE_LOG.victim" "$out"
  printf '%s\n' "$FAKE_STDOUT"; exit 0
fi
fire_hooks() {
  [ "$FAKE_CLAUDE" = dead-hook ] && return
  sh -c "$(sed -n 's/.*"command":"\([^"]*\)".*/\1/p' .claude/settings.json)"
}
case " $* " in
*" --safe-mode "*) [ "$FAKE_CLAUDE" = hook ] && fire_hooks ;;
*)
  echo "control-env HOME=$HOME XDG_CONFIG_HOME=$XDG_CONFIG_HOME XDG_CACHE_HOME=$XDG_CACHE_HOME XDG_DATA_HOME=$XDG_DATA_HOME XDG_STATE_HOME=$XDG_STATE_HOME CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR" >> "${FAKE_LOG:-/dev/null}"
  fire_hooks; echo '{"type": "result", "is_error": true, "result": "Not logged in"}'; exit 1 ;;
esac
# A reviewer pass: the prompt on stdin names the probe script, whose dir holds out/.
probe=$(grep -o "/[^']*/probe\.sh")
out=$(dirname "$probe")/out
case "$FAKE_CLAUDE" in
ignore) echo '{"type": "result", "result": "no"}'; exit 0 ;;
leak) sh "$probe" > /dev/null 2>&1 ;;
lie) git diff > "$out/diff.txt"; echo "write=0 commit=0 branch=0 diff=99" > "$out/probe.txt" ;;
*)
  # What a working sandbox lets through: git diff and writes into out/.
  git diff > "$out/diff.txt"
  echo "write=1 commit=128 branch=128 diff=0" > "$out/probe.txt" ;;
esac
echo '{"type": "result", "result": "done"}'
[ "$FAKE_CLAUDE" = crash ] && exit 42
exit 0
